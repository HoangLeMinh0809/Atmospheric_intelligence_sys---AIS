FROM node:22-alpine AS build

WORKDIR /app

ARG VITE_VIS_API_BASE=/api/v1/visualization
ARG VITE_USE_MOCK_DATA=false
ARG VITE_DEFAULT_HORIZON_H=0
ARG VITE_DEFAULT_MAP_CENTER_LAT=21.0285
ARG VITE_DEFAULT_MAP_CENTER_LON=105.8542
ARG VITE_DEFAULT_MAP_ZOOM=7

ENV VITE_VIS_API_BASE=$VITE_VIS_API_BASE \
    VITE_USE_MOCK_DATA=$VITE_USE_MOCK_DATA \
    VITE_DEFAULT_HORIZON_H=$VITE_DEFAULT_HORIZON_H \
    VITE_DEFAULT_MAP_CENTER_LAT=$VITE_DEFAULT_MAP_CENTER_LAT \
    VITE_DEFAULT_MAP_CENTER_LON=$VITE_DEFAULT_MAP_CENTER_LON \
    VITE_DEFAULT_MAP_ZOOM=$VITE_DEFAULT_MAP_ZOOM

COPY ui/package*.json ./
RUN npm ci

COPY ui/ ./
RUN npm run build

FROM nginx:1.27-alpine

COPY ui/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
